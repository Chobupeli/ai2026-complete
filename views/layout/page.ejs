<!doctype html><html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="/stylesheets/style.css"><link rel="stylesheet" href="/stylesheets/enhance.css"></head><body><div class="project-bar"><a href="/">AI / Главная</a><nav aria-label="Темы AI"><% nav.forEach(function(item){ %><a href="/topics/<%= item.nick %>"><%= item.title %></a><% }); %></nav><% if(authUI){ %><% if(user){ %><span>Пользователь: <%= user.username %></span><form action="/logout" method="post"><button class="btn btn-outline-light btn-sm" type="submit">Выйти</button></form><% }else{ %><a href="/logreg">Вход / Регистрация</a><% } %><% } %><% if(counter){ %><span>Просмотры: <%= counter %></span><% } %></div><%- body %><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><% if(typeof home !== 'undefined' && home){ %><script src="/javascripts/enhance.js" defer></script><script src="/javascripts/script.js" defer></script><% } %></body></html>